#!/bin/sh
# ============================================================================================
#  PRE-COMMIT VERSIONATO -- presidi `H-P3` / `H-P5` / `H-P8`   (vedi csv/_hook_presidi.py)
# --------------------------------------------------------------------------------------------
#  QUESTO FILE E' TRACCIATO DA GIT, a differenza di `.git/hooks/`, che NON viaggia col repo.
#  Perche' conti, ogni clone deve dare UNA VOLTA:
#
#      git config core.hooksPath .githooks
#
#  Finche' quel comando non e' dato, i presidi NON impediscono niente -- e
#  `python csv/_hook_presidi.py` LO DICE, invece di tacere (`A9`).
# ============================================================================================
python "$(git rev-parse --show-toplevel)/csv/_hook_presidi.py" --pre-commit || exit 1
# `P-E1`..`P-E5` e `P-E7` (era 2): la biiezione tabella <-> file <-> registro <-> scheda,
# le impronte, le variabili, le importazioni, e gli osservatori in sola lettura.
# ### NESSUNA VIA D-USCITA per i file di primo_ordine/: il mandato lo dice.
python "$(git rev-parse --show-toplevel)/csv/_presidi_era2.py" --pre-commit || exit 1

#  `P-M1` -- IL DOCUMENTO DEI METODI NON INVECCHIA IN SILENZIO.
#  ### Pretende che OGNI metodo del perimetro (che l'indice calcola da `classe`)
#  ### abbia una riga che dice COME SI APPLICA all'era 2. Una voce `STANDARD` o
#  ### `PRESIDIO` nuova fa RIFIUTARE il commit finche' non ha la sua riga.
python "$(git rev-parse --show-toplevel)/csv/_metodi_era2.py" || exit 1

#  `P-C1` -- ANCHE I CONTROLLI STANNO NELL'INDICE.
#  ### Un ID dichiarato dal codice e NON nell'indice fa RIFIUTARE il commit.
#  ### Una voce `PRESIDIO` che nessun codice dichiara e' un SEGNALE, non un
#  ### errore: potrebbe vivere in shell, o essere proposta e non cablata (`A9`).
python "$(git rev-parse --show-toplevel)/csv/_controlli_nell_indice.py" || exit 1

#  `P-T1` -- IL TESTO LIBERO NON SI INTERPRETA PER DECIDERE.
#  ### Un presidio dichiarato `ERRORE` non puo' nominare un campo di TESTO (via AST):
#  ### chi RIFIUTA decide da campi strutturati, chi legge la prosa PUO' SOLO SEGNALARE.
python "$(git rev-parse --show-toplevel)/csv/_testo_e_metadati.py" || exit 1

#  `P-R1` -- OGNI RAMO DELLA FISICA DELL'ERA 2 E' DICHIARATO.
#  ### `A8`: un ramo silenzioso non e' un ramo. Il CONTEGGIO lo misura l'AST, il
#  ### RUOLO e' dichiarato a vocabolario chiuso. Un ramo nuovo non passa inosservato.
python "$(git rev-parse --show-toplevel)/csv/_rami_era2.py" || exit 1

#  `P-T2` -- IL REPLAY SU TUTTI I REGISTRI, e i generati BYTE-IDENTICI.
#  ### Senza `--con-lenti`: i generati LENTI (il referto, che fa girare i sette
#  ### collaudi) stanno SOLO nella CI. Un presidio di pre-commit da due minuti
#  ### e' una ragione per dare --no-verify.
python "$(git rev-parse --show-toplevel)/csv/_replay_registri.py" || exit 1
