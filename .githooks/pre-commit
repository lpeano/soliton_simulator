#!/bin/sh
# ============================================================================================
#  PRE-COMMIT VERSIONATO -- presidi `H-P3` / `H-P5` / `H-P8`   (vedi csv/_hook_presidi.py)
# --------------------------------------------------------------------------------------------
#  QUESTO FILE E' TRACCIATO DA GIT, a differenza di `.git/hooks/`, che NON viaggia col repo.
#  Perche' conti, ogni clone deve dare UNA VOLTA:
#
#      git config core.hooksPath .githooks
#
#  Finche' quel comando non e' dato, i presidi NON impediscono niente -- e
#  `python csv/_hook_presidi.py` LO DICE, invece di tacere (`A9`).
# ============================================================================================
python "$(git rev-parse --show-toplevel)/csv/_hook_presidi.py" --pre-commit || exit 1
# `P-E1`..`P-E5` e `P-E7` (era 2): la biiezione tabella <-> file <-> registro <-> scheda,
# le impronte, le variabili, le importazioni, e gli osservatori in sola lettura.
# ### NESSUNA VIA D-USCITA per i file di primo_ordine/: il mandato lo dice.
python "$(git rev-parse --show-toplevel)/csv/_presidi_era2.py" --pre-commit || exit 1

#  `P-M1` -- IL DOCUMENTO DEI METODI NON INVECCHIA IN SILENZIO.
#  ### Pretende che OGNI metodo del perimetro (che l'indice calcola da `classe`)
#  ### abbia una riga che dice COME SI APPLICA all'era 2. Una voce `STANDARD` o
#  ### `PRESIDIO` nuova fa RIFIUTARE il commit finche' non ha la sua riga.
python "$(git rev-parse --show-toplevel)/csv/_metodi_era2.py" || exit 1

#  `P-C1` -- ANCHE I CONTROLLI STANNO NELL'INDICE.
#  ### Un ID dichiarato dal codice e NON nell'indice fa RIFIUTARE il commit.
#  ### Una voce `PRESIDIO` che nessun codice dichiara e' un SEGNALE, non un
#  ### errore: potrebbe vivere in shell, o essere proposta e non cablata (`A9`).
python "$(git rev-parse --show-toplevel)/csv/_controlli_nell_indice.py" || exit 1

#  `P-T1` -- IL TESTO LIBERO NON SI INTERPRETA PER DECIDERE.
#  ### Un presidio dichiarato `ERRORE` non puo' nominare un campo di TESTO (via AST):
#  ### chi RIFIUTA decide da campi strutturati, chi legge la prosa PUO' SOLO SEGNALARE.
python "$(git rev-parse --show-toplevel)/csv/_testo_e_metadati.py" || exit 1

#  `P-R1` -- OGNI RAMO DELLA FISICA DELL'ERA 2 E' DICHIARATO.
#  ### `A8`: un ramo silenzioso non e' un ramo. Il CONTEGGIO lo misura l'AST, il
#  ### RUOLO e' dichiarato a vocabolario chiuso. Un ramo nuovo non passa inosservato.
python "$(git rev-parse --show-toplevel)/csv/_rami_era2.py" || exit 1

#  `P-T2` -- IL REPLAY SU TUTTI I REGISTRI, e i generati BYTE-IDENTICI.
#  ### Senza `--con-lenti`: i generati LENTI (il referto, che fa girare i sette
#  ### collaudi) stanno SOLO nella CI. Un presidio di pre-commit da due minuti
#  ### e' una ragione per dare --no-verify.
python "$(git rev-parse --show-toplevel)/csv/_replay_registri.py" || exit 1

#  `P-GRAFO` -- IL GRAFO VALIDO A OGNI PASSO.
#  ### Il collaudo misura anche IL COSTO del controllo in rapporto a un passo
#  ### vero, e pretende che stia sotto il 10%: un presidio che decuplicasse il
#  ### costo si spegnerebbe il primo giorno, ed e' il difetto di `A9`.
python "$(git rev-parse --show-toplevel)/primo_ordine/_collauda_grafo.py" || exit 1

#  `P-ALB` -- L'ALBERO DELLE SCELTE.
#  ### Il collaudo, non il solo `controlla()`: `indice.py valida` lo chiama GIA'
#  ### (ed e' quello che il mandato chiede), ma il collaudo ha il ramo
#  ### END-TO-END che verifica che `valida` ESCA 1 -- cioe' che il presidio non
#  ### si sia spento nel `try` dell'import.
python "$(git rev-parse --show-toplevel)/csv/_albero_era2.py" --collaudo || exit 1

#  L'ARBITRO FRA LE DUE VIE su `leggi.jsonl` e `variabili.jsonl`.
#  ### Un giro del generatore dell'era 1 CANCELLAVA i record dell'era 2 (misurato:
#  ### QUATTRO, e `P-T2` passava 13 su 13 senza vederlo). Il collaudo verifica
#  ### l'IDEMPOTENZA AL BYTE e che un record gia' perso FERMI il generatore.
python "$(git rev-parse --show-toplevel)/csv/_registri_indice.py" --collaudo || exit 1

#  `P-T3` -- LE CITAZIONI SONO STRUTTURATE e si RI-VERIFICANO.
#  ### {file, riga, commit, impronta}: con il commit una citazione e' vera PER
#  ### SEMPRE, perche' `git show <commit>:<file>` da' sempre gli stessi byte.
python "$(git rev-parse --show-toplevel)/csv/_citazioni_strutturate.py" || exit 1

#  `P-RIF` -- UN ID NEL CODICE E' UN @rif, O NON ESISTE.
#  ### Un ID in un COMMENTO e' prosa, e un riferimento che una macchina deve
#  ### seguire non vive nella prosa. ### I DOCSTRING sono documentazione e
#  ### restano: il confine e' DICHIARATO nel docstring del presidio.
python "$(git rev-parse --show-toplevel)/csv/_rif_nel_codice.py" || exit 1

#  `P-ES1` -- UN SOLO ESECUTORE (punto 9, generalizza H-P9).
#  ### Chi avanza lo stato passa dallo schedulatore. Le eccezioni sono
#  ### DICHIARATE una per una con il loro perche', e il resto e' rifiutato.
python "$(git rev-parse --show-toplevel)/csv/_un_solo_esecutore.py" || exit 1

#  `P-MOD` -- LA MODULARITA' NON SI DEGRADA (punto 11).
#  ### La mappa dice cio' che e' PREVISTO: un import fuori mappa, un ciclo, un
#  ### modulo non in mappa, un file oltre il tetto, una responsabilita' che non
#  ### sta in una riga -> RIFIUTATI. E hamiltoniana/passo SOLO sommano.
python "$(git rev-parse --show-toplevel)/csv/_modularita_era2.py" || exit 1

#  `P-AB` -- I CONFRONTI COL CAMPO UNICO, e i DATI col loro formato (15d, 15e).
#  ### Un A/B che differisce in DUE campi non parte: e' la lezione di Z20 -- un
#  ### confronto con due variabili e' DUE MISURE SOVRAPPOSTE. E ogni dato ha il
#  ### suo TIMBRO accanto, con la versione del formato.
python "$(git rev-parse --show-toplevel)/csv/_confronti_e_dati.py" || exit 1
