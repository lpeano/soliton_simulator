#!/bin/sh
# ============================================================================================
#  COMMIT-MSG VERSIONATO -- `H-P1-bis` (la relazione) + `H-REG-R` (la scheda) + `H-INDICE` + `H-RIGHE`
# --------------------------------------------------------------------------------------------
#  `csv/_hook_relazione.py` fa DUE controlli, non uno: rifiuta un commit che tocca un referto
#  senza toccare `RELAZIONE_PER_CLAUDE.md`, e da li' chiama `csv/_hook_fisica.py` (`REG-R`),
#  che rifiuta un commit in cui una LEGGE cambia e la sua SCHEDA no.
#
#  QUESTO FILE E' TRACCIATO DA GIT. Ogni clone deve dare UNA VOLTA:
#      git config core.hooksPath .githooks
# ============================================================================================
# `H-FILE` gira PRIMO, e di proposito: se la lista dei file e' sbagliata, il messaggio va
# riscritto comunque, e saperlo subito evita di sistemare la relazione per poi rifare tutto.
python csv/_hook_file_cambiati.py --controlla "$1" || exit 1
# `H-NON-TRACCIATI` (decisione di Luca, 2026-10-04): blocca se esistono file non
# tracciati e NON ignorati sotto csv/ o doc/. Via d'uscita a INIZIO RIGA:
#   [SENZA-NON-TRACCIATI: <motivo>]
python csv/_hook_non_tracciati.py --controlla "$1" || exit 1
# `H-ID-OBBLIGATORIO` (2026-10-09, punto 8): un commit che tocca un file della LISTA di
# csv/_file_fisica.py, o un doc/REFERTO_* / doc/REPERTO_*, CITA almeno un ID dell'indice.
# E' il ROVESCIO di H-INDICE, che controlla che gli ID citati ESISTANO. Via d'uscita a
# INIZIO RIGA, la stessa:  [SENZA-INDICE: <motivo>]
python csv/_hook_id_obbligatorio.py --controlla "$1" || exit 1
exec python csv/_hook_relazione.py --controlla "$1"
