# Output sperimentali e artefatti generati: non fanno parte del repository.
out_*/
log/
__pycache__/
*.py[cod]
*.mp4
*.avi
*.mov
*.mkv
*.csv
*.log
*.pkl
*.pickle
*.npy
*.npz

# Risultati ELAST_C conservati nel repository (mai i video o i DB/cache).
!out_elast/
!out_elast/*.csv
!log/
!log/elast*.log

# Risultati A/B spinore-vivo conservati nel repository (mai i DB .pkl).
!out_spinore/
!out_spinore/*.csv
!log/spinore*.log

# Risultati A/B spinore-vivo + plasticita' dinamica.
!out_spinore_plastdin/
!out_spinore_plastdin/*.csv
!log/pd_*.log

# Risultati campagna congelamento da guscio (spin_core + inerzia) e A/B guscio-morbido (mai i .pkl).
!out_spincore/
!out_spincore/*.csv
!out_guscio_morbido/
!out_guscio_morbido/*.csv
!log/spincore_*.log
!log/guscio_*.log

# Risultati A/B --tw-spinore (aggancio doppia copertura) e regimi (mai i .pkl).
!out_tw_spinore/
!out_tw_spinore/*.csv
!out_guscio_regimi/
!out_guscio_regimi/*.csv
!out_guscio_fase1/
!out_guscio_fase1/*.csv
!log/tw_spinore_*.log
!log/guscio_regimi_*.log
!log/guscio_fase1_*.log
