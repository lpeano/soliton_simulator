# Output sperimentali e artefatti generati: non fanno parte del repository.
out_*/
log/
__pycache__/
*.py[cod]
*.mp4
*.avi
*.mov
*.mkv
*.csv
*.log
*.pkl
*.pickle
*.npy
*.npz

# Risultati ELAST_C conservati nel repository (mai i video o i DB/cache).
!out_elast/
!out_elast/*.csv
!log/
!log/elast*.log

# Risultati A/B spinore-vivo conservati nel repository (mai i DB .pkl).
!out_spinore/
!out_spinore/*.csv
!log/spinore*.log

# Risultati A/B spinore-vivo + plasticita' dinamica.
!out_spinore_plastdin/
!out_spinore_plastdin/*.csv
!log/pd_*.log
